---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";

const plans = [
  {
    name: "Community",
    price: "$0",
    period: "forever",
    description: "Open source under Apache-2.0. Free for any use, including commercial.",
    features: [
      "All features — no limits",
      "Commercial use included",
      "Signed binaries via Homebrew & GitHub Releases",
      "Community support (GitHub Issues & Discussions)",
    ],
    cta: { text: "Download Free", href: "/docs/download" },
    highlight: false,
  },
  {
    name: "Priority Support",
    price: "$149",
    period: "/yr per company",
    description: "For teams that rely on PgDesigner at work.",
    popular: true,
    features: [
      "Private email support",
      "Response within 2 business days",
      "Your team's bugs go first in the queue",
      "Help migrating from pgModeler, MicroOLAP, DbSchema",
      "Invoice for your accounting",
    ],
    cta: { text: "Get Priority Support", href: "https://buy.stripe.com/8x200keWm5Hbe9k61N33W01" },
    highlight: true,
  },
  {
    name: "Enterprise Support",
    price: "from $990",
    period: "/yr",
    description: "For companies that need guaranteed response times.",
    features: [
      "Response within 1 business day",
      "Private chat channel",
      "Onboarding call for your team",
      "Priority on the roadmap",
      "Pay by invoice / PO",
    ],
    cta: { text: "Contact Us", href: "mailto:support@pgdesigner.io?subject=Enterprise%20Support" },
    highlight: false,
  },
];

const faqs = [
  {
    q: "Is PgDesigner really free for commercial use?",
    a: "Yes. PgDesigner is open source under the Apache License 2.0. Use it at work, in CI, for client projects, or in your own product — no license key, no seat count, no registration.",
  },
  {
    q: "What does Priority Support include?",
    a: "A private email channel with a response within 2 business days, bugs reported by your team handled first, and help with migrating existing models from pgModeler, MicroOLAP Database Designer, or DbSchema. You get an invoice for your accounting.",
  },
  {
    q: "Why pay if the software is free?",
    a: "You pay for our time, not for the right to use the software: guaranteed responses, faster fixes for the issues that block your team, and a say in what we build next. It also funds PgDesigner's development.",
  },
  {
    q: "Can you build a feature we need?",
    a: "Yes. Sponsored development is available on a custom quote — for example, a new import format or a lint rule specific to your conventions. Sponsored features ship in the open-source release. Email support@pgdesigner.io.",
  },
  {
    q: "I used PgDesigner under the PolyForm Noncommercial license. What changes?",
    a: "Nothing you need to do. Every release, including all earlier versions, is now available under Apache-2.0.",
  },
  {
    q: "Can I build from source?",
    a: "Yes. You need Go and pnpm — see the download page. Prebuilt, signed binaries are available via Homebrew and GitHub Releases.",
  },
  {
    q: "Do you offer refunds?",
    a: "Yes, 30-day money-back guarantee on support subscriptions. If it doesn't work out, email us and we'll refund — no questions asked.",
  },
  {
    q: "Where is my data stored?",
    a: "On your machine. PgDesigner is offline-first — no cloud account, no telemetry. Your .pgd files live in your git repository.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a },
  })),
};
---

<Layout title="Pricing — Free & Open Source, Paid Support" description="PgDesigner is free and open source under Apache-2.0 — for any use, including commercial. All features included. Optional Priority Support from $149/year per company.">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <Container>
    <div class="max-w-5xl mx-auto pt-16 pb-24">
      <div class="text-center">
        <h1 class="text-4xl lg:text-5xl font-bold tracking-tight text-heading">
          Free and open source. Paid support.
        </h1>
        <p class="mt-4 text-lg text-body max-w-2xl mx-auto">
          PgDesigner is open source under Apache-2.0 — every feature, for any use, including commercial. Companies that rely on it can buy priority support.
        </p>
      </div>

      <!-- Plans grid -->
      <div id="support" class="grid md:grid-cols-3 gap-5 mt-14 max-w-4xl mx-auto scroll-mt-24">
        {plans.map((plan) => (
          <div class:list={[
            "rounded-xl p-6 flex flex-col relative",
            plan.highlight
              ? "bg-blue-600/10 border-2 border-blue-500/50 ring-1 ring-blue-500/20"
              : "bg-surface-alt border border-border-default",
          ]}>
            {plan.popular && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 text-[10px] font-bold uppercase tracking-wider bg-blue-600 text-white px-3 py-0.5 rounded-full">
                Recommended
              </span>
            )}
            <div>
              <h2 class="text-lg font-semibold text-heading">{plan.name}</h2>
              <div class="mt-3 flex items-baseline gap-1">
                <span class="text-4xl font-bold text-heading">{plan.price}</span>
                <span class="text-sm text-muted">{plan.period}</span>
              </div>
              <p class="mt-2 text-sm text-muted">{plan.description}</p>
            </div>
            <ul class="mt-6 space-y-2.5 flex-1">
              {plan.features.map((f) => (
                <li class="flex gap-2 text-sm text-body">
                  <span class="text-positive mt-0.5 shrink-0">✓</span>
                  {f}
                </li>
              ))}
            </ul>
            <a
              href={plan.cta.href}
              class:list={[
                "mt-6 inline-flex items-center justify-center rounded-lg px-4 py-2.5 text-sm font-semibold transition-colors",
                plan.highlight
                  ? "bg-blue-600 text-white hover:bg-blue-500"
                  : "bg-surface-alt border border-border-default text-heading hover:bg-surface-alt/80",
              ]}>
              {plan.cta.text}
            </a>
          </div>
        ))}
      </div>

      <!-- Competitor pricing comparison -->
      <div class="mt-16 text-center">
        <h2 class="text-2xl font-bold text-heading mb-6">How our pricing compares</h2>
        <div class="overflow-x-auto">
          <table class="w-full max-w-2xl mx-auto text-sm">
            <thead>
              <tr class="border-b border-border-default">
                <th class="py-3 px-4 text-left font-semibold text-heading">Tool</th>
                <th class="py-3 px-4 text-center font-semibold text-heading">Individual</th>
                <th class="py-3 px-4 text-center font-semibold text-heading">Team (5 devs, 1yr)</th>
              </tr>
            </thead>
            <tbody class="text-body">
              <tr class="border-b border-border-default bg-blue-600/5">
                <td class="py-2.5 px-4 font-semibold text-heading">PgDesigner</td>
                <td class="py-2.5 px-4 text-center font-semibold text-heading">Free</td>
                <td class="py-2.5 px-4 text-center font-semibold text-heading">Free (open source)</td>
              </tr>
              <tr class="border-b border-border-default">
                <td class="py-2.5 px-4">pgModeler</td>
                <td class="py-2.5 px-4 text-center">from $49.90</td>
                <td class="py-2.5 px-4 text-center">~$250</td>
              </tr>
              <tr class="border-b border-border-default">
                <td class="py-2.5 px-4">Atlas Pro</td>
                <td class="py-2.5 px-4 text-center">$9/dev/mo</td>
                <td class="py-2.5 px-4 text-center">$540+/yr</td>
              </tr>
              <tr class="border-b border-border-default">
                <td class="py-2.5 px-4">dbdiagram.io Pro</td>
                <td class="py-2.5 px-4 text-center">$9/mo</td>
                <td class="py-2.5 px-4 text-center">$540/yr</td>
              </tr>
              <tr class="border-b border-border-default">
                <td class="py-2.5 px-4">DbSchema</td>
                <td class="py-2.5 px-4 text-center">$147</td>
                <td class="py-2.5 px-4 text-center">$735</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Trust signals -->
      <div class="mt-16 grid sm:grid-cols-3 gap-6 max-w-3xl mx-auto">
        <div class="text-center">
          <p class="text-2xl font-bold text-heading">Apache-2.0</p>
          <p class="text-sm text-muted mt-1">Free for any use, including commercial. Source on GitHub.</p>
        </div>
        <div class="text-center">
          <p class="text-2xl font-bold text-heading">No paid edition</p>
          <p class="text-sm text-muted mt-1">Every feature is in the open-source build. Support plans buy our time, not features.</p>
        </div>
        <div class="text-center">
          <p class="text-2xl font-bold text-heading">Your data, your machine</p>
          <p class="text-sm text-muted mt-1">Offline-first. No cloud account. No telemetry. Files live in your git repo.</p>
        </div>
      </div>

      <!-- FAQ -->
      <div class="mt-20 max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-heading text-center mb-8">Frequently asked questions</h2>
        <div class="space-y-6">
          {faqs.map(({ q, a }) => (
            <div class="border-b border-border-default pb-5">
              <h3 class="font-semibold text-heading">{q}</h3>
              <p class="mt-2 text-sm text-body leading-relaxed">{a}</p>
            </div>
          ))}
        </div>

        <div class="mt-10 pt-6 border-t border-border-default">
          <p class="text-sm font-semibold text-heading mb-3">Explore more</p>
          <div class="flex flex-wrap gap-3">
            <a href="/features" class="text-sm text-accent-text hover:underline">All Features →</a>
            <a href="/compare/pgmodeler" class="text-sm text-accent-text hover:underline">PgDesigner vs pgModeler →</a>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Layout>
