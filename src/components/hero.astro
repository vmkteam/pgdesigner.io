---
import Container from "@/components/container.astro";
---

<Container>
  <main class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24 gap-8">
    <div>
      <a
        href="/blog/pgdesigner-is-now-open-source"
        class="inline-flex items-center gap-2 mb-5 rounded-full border border-blue-500/40 bg-blue-600/10 px-3 py-1 text-xs font-medium text-accent-text hover:bg-blue-600/20 transition-colors">
        <span class="rounded-full bg-blue-600 px-1.5 py-px text-[10px] font-bold uppercase tracking-wider text-white">New</span>
        Now open source under Apache-2.0 &rarr;
      </a>
      <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold lg:tracking-tight xl:tracking-tighter text-heading">
        Visual PostgreSQL Schema Designer
      </h1>
      <p class="text-lg mt-4 text-muted max-w-xl">
        Visual ERD diagrams, DDL generation, schema diff &amp; safe ALTER migrations for PostgreSQL.
      </p>
      <div class="mt-4 inline-flex items-center gap-3 rounded-lg border border-border-default bg-surface-alt px-4 py-2 font-mono text-sm text-body">
        <span class="select-none text-faint">$</span>
        <code id="install-cmd">brew install vmkteam/tap/pgdesigner</code>
        <button
          type="button"
          data-copy="install-cmd"
          class="text-faint hover:text-heading transition-colors"
          aria-label="Copy install command">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-9.376h-1.5a1.125 1.125 0 0 0-1.125 1.125v3.375m9.375 3.375-.002.375m.002-.375h-3.375a1.125 1.125 0 0 1-1.125-1.125V6.75m4.5 4.5V8.625c0-1.036-.84-1.875-1.875-1.875h-.75"/></svg>
        </button>
      </div>
      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <a
          href="/docs/download"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-white hover:bg-blue-500 hover:shadow-[0_0_24px_rgba(37,99,235,0.35)] transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
          Download Free
        </a>
        <a
          href="https://demo.pgdesigner.io"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-border-default px-6 py-3 text-sm font-semibold text-body hover:bg-surface-alt transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
          Try Live Demo
        </a>
      </div>

      <!-- Stats -->
      <div class="mt-8 grid grid-cols-4 gap-4 sm:flex sm:gap-6 sm:items-center">
        <div class="flex flex-col">
          <span class="text-xl font-bold text-heading tabular-nums">630+</span>
          <span class="text-[10px] uppercase tracking-wider text-faint">tables tested</span>
        </div>
        <div class="hidden sm:block w-px h-8 bg-border-default"></div>
        <div class="flex flex-col">
          <span class="text-xl font-bold text-heading tabular-nums">99.7%</span>
          <span class="text-[10px] uppercase tracking-wider text-faint">fidelity</span>
        </div>
        <div class="hidden sm:block w-px h-8 bg-border-default"></div>
        <div class="flex flex-col">
          <span class="text-xl font-bold text-heading tabular-nums">69</span>
          <span class="text-[10px] uppercase tracking-wider text-faint">lint rules</span>
        </div>
        <div class="hidden sm:block w-px h-8 bg-border-default"></div>
        <div class="flex flex-col">
          <span class="text-xl font-bold text-heading tabular-nums">Free</span>
          <span class="text-[10px] uppercase tracking-wider text-faint">Apache-2.0</span>
        </div>
      </div>
    </div>

    <!-- ERD Screenshot -->
    <div class="w-full md:order-1">
      <div class="rounded-xl overflow-hidden border border-border-default shadow-2xl shadow-black/20 dark:shadow-black/50 dark:shadow-[0_25px_80px_rgba(0,0,0,0.5),0_0_60px_rgba(37,99,235,0.1)] hover:shadow-[0_25px_80px_rgba(0,0,0,0.3),0_0_80px_rgba(37,99,235,0.08)] dark:hover:shadow-[0_25px_80px_rgba(0,0,0,0.5),0_0_80px_rgba(37,99,235,0.15)] transition-shadow duration-300">
        <picture class="hidden dark:block">
          <source
            srcset="/images/dark-1x.webp 1x, /images/dark-2x.webp 2x"
            type="image/webp"
          />
          <img
            src="/images/dark.png"
            alt="PgDesigner — ERD diagram of chinook database"
            class="w-full h-auto"
            width="1109"
            height="857"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
        <picture class="block dark:hidden">
          <source
            srcset="/images/light-1x.webp 1x, /images/light-2x.webp 2x"
            type="image/webp"
          />
          <img
            src="/images/light.png"
            alt="PgDesigner — ERD diagram of chinook database"
            class="w-full h-auto"
            width="1109"
            height="857"
            loading="lazy"
          />
        </picture>
      </div>
    </div>
  </main>
</Container>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) =>
    btn.addEventListener("click", async () => {
      const text = document.getElementById(btn.dataset.copy!)?.textContent ?? "";
      await navigator.clipboard.writeText(text);
      btn.classList.add("text-positive");
      setTimeout(() => btn.classList.remove("text-positive"), 1200);
    }),
  );
</script>
